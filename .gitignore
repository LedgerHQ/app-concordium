# Compilation files of the application
build/

# Legacy compilation output
bin/
debug/

# Temporary directory with snapshots taken during test runs
tests/snapshots-tmp/
tests/standalone/snapshots-tmp/

# Unit tests and code coverage
unit-tests/build/
unit-tests/coverage/
unit-tests/coverage.info

# Fuzzing
fuzzing/build*/
fuzzing/corpus/
fuzzing/crashes/
fuzzing/out/
fuzzing/.cache/
# Seeds and dictionaries are generated from tests/standalone/ by
# fuzzing/tools/generate_seed_corpus.py, which both build.sh and run_local.sh invoke. The
# generator is the tracked source of truth; the ~300 derived blobs are not.
fuzzing/seeds/
fuzzing/dictionaries/

# Python
*.pyc[cod]
*.egg
__pycache__/
*.egg-info/
.eggs/
.python-version
.venv/

# Doxygen
doc/html
doc/latex

# Virtual env for sideload (macOS and Windows)
/ledger/

# macOS
.DS_Store

# Helpers
diff

# Vscode — track udev rules (Ledger app-boilerplate style); ignore local settings
.vscode/*
!.vscode/20-ledger.ledgerblue.rules

# clangd (language server index; may appear under fuzzing/ or repo root)
.cache/

# folder to store local helper scripts
scripts_local/
tmp/
.claude/

# Local checkout, not a submodule. Committing it as a gitlink without a matching .gitmodules
# entry breaks every CI job that clones with --recursive.
deps/